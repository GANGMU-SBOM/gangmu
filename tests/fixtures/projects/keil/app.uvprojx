<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Project>
  <SchemaVersion>2.1</SchemaVersion>
  <Targets>
    <Target>
      <TargetName>Flash</TargetName>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File>
              <FileName>main.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\..\project\src\main.c</FilePath>
            </File>
            <File>
              <FileName>never_built.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\..\project\src\never_built.c</FilePath>
              <FileOption>
                <CommonProperty>
                  <IncludeInBuild>0</IncludeInBuild>
                </CommonProperty>
              </FileOption>
            </File>
          </Files>
        </Group>
        <Group>
          <GroupName>tinynet</GroupName>
          <Files>
            <File>
              <FileName>core.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\..\project\components\net\tinynet\src\core.c</FilePath>
            </File>
            <File>
              <FileName>tinynet.h</FileName>
              <FileType>5</FileType>
              <FilePath>..\..\project\components\net\tinynet\include\tinynet\tinynet.h</FilePath>
            </File>
          </Files>
        </Group>
      </Groups>
    </Target>
    <Target>
      <TargetName>RAM</TargetName>
      <Groups>
        <Group>
          <GroupName>Application</GroupName>
          <Files>
            <File>
              <FileName>debug_only.c</FileName>
              <FileType>1</FileType>
              <FilePath>..\..\project\src\debug_only.c</FilePath>
            </File>
          </Files>
        </Group>
      </Groups>
    </Target>
  </Targets>
</Project>
